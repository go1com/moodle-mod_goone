<style>
    .form-inline label {
        display:block;
    }
    .multiselect-clear-filter{
        display: none;
    }
    .row{
        display: flex;
    }
    .go1-provider p{
        font-weight: 300!important;
    }
    .badge {
        margin-left:1rem;
        margin-right:0.5rem;
    }
    .preloader {
        text-align: center;
    }
    .modal-body {
        overflow:auto;
        height:55rem;
    }
    .card-img-top {
        width:100%;
        margin-left: auto!important;
        margin-right: auto!important;
    }

    /* The filter bar uses .form-row, .form-group and a badge colour. Bootstrap 4
       gives these rules and Bootstrap 5 does not. The plugin gives them here, with
       the same values as Bootstrap 4, thus the filter bar looks the same under
       Bootstrap 4 and under Bootstrap 5. */
    .goone-filters .form-row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -5px;
        margin-left: -5px;
    }
    .goone-filters .form-row > [class*="col-"] {
        padding-right: 5px;
        padding-left: 5px;
    }
    .goone-filters .form-group {
        margin-bottom: 1rem;
    }
    .goone-filters label {
        display: block;
        margin-left: 0;
    }
    /* .form-group is a flex row that wraps. The label goes above its control only
       when the label and the control together are wider than the column. That is
       true on Moodle 4.5, and not true on Moodle 5.0 and later. Give the label a
       full line, thus the position does not change with the width. */
    .goone-filters .form-group > label {
        flex: 0 0 100%;
        max-width: 100%;
    }
    .goone-filters select.custom-select {
        display: block;
        width: 100%;
    }
    /* Bootstrap 5 sets .badge { color: #fff }. The badge is then not visible on the
       light card. Bootstrap 4 lets the badge use the colour of the parent. */
    .badge.badge-black {
        color: inherit;
    }
    /* The multiselect library lines up the words of its button and of its menu
       with a Bootstrap class that belongs to ONE version: text-left under
       Bootstrap 4, text-start under Bootstrap 5. The module gives the library
       buttonTextAlignment false, thus the library adds no class and these rules
       hold the alignment under every Bootstrap.

       The rules hang on .multiselect-native-select, which the library puts around
       each select. They do not hang on .goone-filters: the form tag reaches the
       browser only when GO1 sends facets, thus .goone-filters is not always a
       parent of a filter. */
    .multiselect-native-select button.multiselect,
    .multiselect-native-select .multiselect-container,
    .multiselect-native-select .multiselect-option,
    .multiselect-native-select .multiselect-group,
    .multiselect-native-select .multiselect-all {
        text-align: left;
    }

    /* Each option holds a span.form-check with the checkbox and the words. Moodle
       has the rule ".form-inline .form-check { justify-content: center }", and the
       filter bar is a form-inline, thus that rule applies to every option. It is
       flexbox, which a text-align rule does not control. Three class names here
       beat the two of the Moodle rule. */
    .multiselect-native-select .multiselect-container .form-check {
        justify-content: flex-start;
    }
</style>




<div class="container" >
    <h2>{{# str }} filters, mod_goone {{/ str }}</h2>
    <form class="form-inline goone-filters">
        <div class="form-row w-100 mb-2">
            <div class="form-group col-sm-10 col-lg-10">
                <div>
                <label for="keyword" class="control-label ml-0">{{# str }} keyword, mod_goone {{/ str }}
                </label>
            </div>
                <input type="text"  class="form-control w-100" name="keyword" id="keyword"/>
            </div>

            <div class="form-group col-sm-2 col-lg-2 float-right">
                <div><label class="control-label ml-0" for="sort">
                    Sort
                </label>
            </div>
            <select class="custom-select w-100" id="sort" name="sort">
                    <option value="relevance">{{# str }} relevance, mod_goone {{/ str }}</option><option value="popularity" selected>{{# str }} popularity, mod_goone {{/ str }}</option><option value="price">{{# str }} price, mod_goone {{/ str }}</option><option value="title">{{# str }} title, mod_goone {{/ str }}</option><option value="created">{{# str }} created, mod_goone {{/ str }}</option>
                </select>
            </div>
        </div>

        <div class="form-row container-fluid">
            <div class="form-group col-sm-6 col-md-3">
                <label for="provider" class="control-label ml-0">
                {{# str }} providers, mod_goone {{/ str }}
            </label>
            {{#facets}}{{#instance}}
            <div>
            <select name="provider" id="provider" class="form-control form-control-sm multiselect-search" multiple="multiple">
                    {{#buckets}}
                    <option value="{{ key }}">{{ name }}</option>
                    {{/buckets}}
                </select>
            </div>
            {{/instance}}{{/facets}}
            </div>
            <div class="form-group col-sm-6 col-md-3">
                <label class="control-label ml-0" for="language">
                {{#facets}}{{#language}}{{# str }} language, mod_goone {{/ str }}
            </label>
            <div>
            <select name="language" id="language" class="form-control form-control-sm form-control-sm multiselect-search" multiple="multiple">
                    {{#buckets}}<option value="{{ key }}" {{selected}}>{{ name }}</option>{{/buckets}}
                    {{/language}}{{/facets}}
                </select>
            </div>
            </div>
            <div class="form-group col-sm-6 col-md-3">
                <label class="control-label ml-0" for="tag">
                {{#facets}}{{#tag}}{{# str }} tag, mod_goone {{/ str }}
            </label>
            <div>
            <select name="tag" id="tag" class="form-control form-control-sm multiselect-search" multiple="multiple">
                    {{#buckets}}<option value="{{ key }}">{{ key }}</option>{{/buckets}}
                    {{/tag}}{{/facets}}
                </select>
            </div>
            </div>
            <div class="form-group col-sm-6 col-md-3">
                <label class="control-label ml-0" for="type">
                    {{# str }} type, mod_goone {{/ str }}
                </label>
                <div>
                <select name="type" id="type" class="form-control form-control-sm multiselect-search" multiple="multiple">
                    <option value="activities">activities</option><option value="assignment">assignment</option><option value="attendance">attendance</option><option value="award">award</option><option value="course">course</option><option value="document">document</option><option value="event">event</option><option value="h5p">h5p</option><option value="iframe">iframe</option><option value="integration">integration</option><option value="interactive">interactive</option><option value="learning_pathway">learning_pathway</option><option value="learning_resource">learning_resource</option><option value="lti">lti</option><option value="question">question</option><option value="quiz">quiz</option><option value="resource">resource</option><option value="text">text</option><option value="video">video</option><option value="workshop">workshop</option>
                </select>
            </div>
            </div>
        </div>

            </form>

</div>


<div class="container">
        <div id="latest-go1-result">
            <h2>{{# str }} results, mod_goone {{/ str }}:</h2>
        </div>
        <div id="goone-browser-results">


        </div>

        <div id="spinny" class="preloader w-100 text-center" style="display:block;">
            <img src="pix/spinner.gif">
        </div>
                <div id="load-more-div" class="w-100 text-center my-2" style="display:none;">
        <button id="load-more" class="btn btn-primary margin-top-5"> {{# str }} loadmore, mod_goone {{/ str }}</button>
        </div>
                        <div id="end-of-results" class="w-100 text-center my-2" style="display:none;">
        {{# str }} endofresults, mod_goone {{/ str }}
        </div>

{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}

